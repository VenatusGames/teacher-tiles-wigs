rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function teacher(owner) { return signedIn() && request.auth.uid == owner; }
    function envelope(data, maxSize) {
      return data.version == 1 && data.iv is string && data.iv.matches('^[A-Za-z0-9+/]{16}$')
        && data.ciphertext is string && data.ciphertext.size() >= 24 && data.ciphertext.size() <= maxSize
        && data.ciphertext.matches('^[A-Za-z0-9+/]+={0,2}$');
    }
    function cipherOnly(data, maxSize) {
      return data.keys().hasOnly(['version','iv','ciphertext']) && envelope(data,maxSize);
    }
    function packed(data) {
      return data.keys().hasOnly(['version','iv','ciphertext','storage','partCount'])
        && data.storage == 2 && data.partCount is int && data.partCount >= 1 && data.partCount <= 4
        && envelope(data,950000);
    }
    function legacyWritable(owner) {
      return !('storage' in get(/databases/$(database)/documents/classes/$(owner)).data);
    }
    function legacyDeletable(owner) {
      let data = get(/databases/$(database)/documents/classes/$(owner)).data;
      return !('storage' in data) || data.storage == 2;
    }
    function publicAccessActive(token) {
      let path = /databases/$(database)/documents/studentAccess/$(token);
      return exists(path) && get(path).data.version == 2 && get(path).data.active == true;
    }
    function ownsPublicAccessToken(token) {
      let configPath = /databases/$(database)/documents/classes/$(request.auth.uid)/studentAccess/config;
      return signedIn() && exists(configPath)
        && get(configPath).data.version == 1
        && get(configPath).data.token == token;
    }
    function publicAccessOwner(token) {
      let path = /databases/$(database)/documents/studentAccess/$(token);
      return ownsPublicAccessToken(token)
        && (!exists(path) || get(path).data.ownerId == request.auth.uid);
    }
    function publicRoot(data) {
      return data.keys().hasOnly(['version','ownerId','active','title','description','studentIds','questionIds','answerIds'])
        && data.version == 2 && data.ownerId is string && data.ownerId.size() > 0
        && data.active == true && data.title is string && data.title.size() <= 160
        && data.description is string && data.description.size() <= 4000
        && data.studentIds is list && data.questionIds is list && data.answerIds is list;
    }
    // Legacy email directory retirement only.
    match /studentLinks/{id} {
      allow get, delete: if signedIn() && (resource == null || resource.data.ownerId == request.auth.uid);
    }
    // A token is a capability URL: it can be fetched directly, but the token
    // collection itself cannot be listed by anonymous clients.
    match /studentAccess/{token} {
      allow get: if (resource != null && resource.data.version == 2 && resource.data.active == true)
        || publicAccessOwner(token);
      allow create: if publicAccessOwner(token) && publicRoot(request.resource.data)
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if publicAccessOwner(token) && publicRoot(request.resource.data)
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if signedIn() && (resource == null || resource.data.ownerId == request.auth.uid);

      match /students/{studentId} {
        allow read: if publicAccessActive(token);
        allow create, update, delete: if publicAccessOwner(token);
      }
      match /questions/{questionId} {
        allow read: if publicAccessActive(token);
        allow create, update, delete: if publicAccessOwner(token);
      }
      match /answers/{answerId} {
        allow read: if publicAccessActive(token);
        allow create, update, delete: if publicAccessOwner(token);
      }
      match /responses/{responseId} {
        allow read: if publicAccessActive(token);
        allow create: if publicAccessOwner(token)
          || (publicAccessActive(token)
            && request.resource.data.keys().hasOnly(['version','day','studentId','studentName','createdAt','items','imported'])
            && request.resource.data.version == 1
            && request.resource.data.day is string
            && request.resource.data.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && request.resource.data.studentId is string
            && request.resource.data.studentId.size() >= 1
            && request.resource.data.studentId.size() <= 100
            && responseId == request.resource.data.day + '_' + request.resource.data.studentId
            && exists(/databases/$(database)/documents/studentAccess/$(token)/students/$(request.resource.data.studentId))
            && request.resource.data.studentName is string
            && request.resource.data.studentName.size() >= 1
            && request.resource.data.studentName.size() <= 100
            && request.resource.data.createdAt == request.time
            && request.resource.data.items is list
            && request.resource.data.items.size() >= 1
            && request.resource.data.items.size() <= 20
            && request.resource.data.imported == false);
        allow update, delete: if publicAccessOwner(token);
      }
    }
    match /classes/{owner} {
      allow get: if teacher(owner);
      // Packed reads/writes authorize directly from the UID: no dependent rule reads.
      allow create: if teacher(owner) && packed(request.resource.data);
      allow update: if teacher(owner) && (packed(request.resource.data)
        || (request.resource.data.storage == 'packing' && (!('storage' in resource.data) || resource.data.storage == 'packing')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['storage'])));
      match /parts/{part} {
        allow get: if teacher(owner);
        allow create, update: if teacher(owner) && part.matches('^[1-3]$') && cipherOnly(request.resource.data,950000);
        allow delete: if teacher(owner);
      }
      match /historyMonths/{month} {
        allow get: if teacher(owner);
        allow create, update: if teacher(owner) && month.matches('^[0-9]{4}-[0-9]{2}$') && packed(request.resource.data);
        match /parts/{part} {
          allow get: if teacher(owner);
          allow create, update: if teacher(owner) && part.matches('^[1-3]$') && cipherOnly(request.resource.data,950000);
          allow delete: if teacher(owner);
        }
      }
      match /studentAccess/{configId} {
        allow get: if teacher(owner);
        allow create, update: if teacher(owner) && configId == 'config'
          && request.resource.data.keys().hasOnly(['version','token'])
          && request.resource.data.version == 1
          && request.resource.data.token is string
          && request.resource.data.token.matches('^[A-Za-z0-9_-]{32,96}$');
        allow delete: if teacher(owner) && configId == 'config';
      }
      match /keys/{keyId} {
        allow get: if teacher(owner);
        allow create: if teacher(owner)
          && (keyId == 'shared' || keyId.matches('^student_[A-Za-z0-9-]{1,100}$'))
          && request.resource.data.keys().hasOnly(['version','keyMaterial'])
          && request.resource.data.version == 1 && request.resource.data.keyMaterial is string
          && request.resource.data.keyMaterial.matches('^[A-Za-z0-9+/]{43}=$');
        // Existing keys cannot be replaced or deleted, including during migration.
      }
      // Legacy sources remain readable for resumable conversion. Once frozen,
      // older clients cannot add or edit records behind the packed class snapshot.
      match /students/{id} {
        allow read: if teacher(owner);
        allow delete: if teacher(owner) && legacyDeletable(owner);
        allow create, update: if teacher(owner) && legacyWritable(owner) && cipherOnly(request.resource.data,60000);
        match /responses/{day} {
          allow read: if teacher(owner);
          allow delete: if teacher(owner) && legacyDeletable(owner);
          allow create: if teacher(owner) && legacyWritable(owner)
            && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && cipherOnly(request.resource.data,950000);
        }
      }
      match /questions/{id} {
        allow read: if teacher(owner);
        allow delete: if teacher(owner) && legacyDeletable(owner);
        allow create, update: if teacher(owner) && legacyWritable(owner) && cipherOnly(request.resource.data,16000);
      }
      match /answers/{id} {
        allow read: if teacher(owner);
        allow delete: if teacher(owner) && legacyDeletable(owner);
        allow create, update: if teacher(owner) && legacyWritable(owner) && cipherOnly(request.resource.data,60000);
      }
    }
  }
}
